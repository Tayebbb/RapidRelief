@page "/admin/command-center"
@attribute [Authorize(Roles = RapidRelief.Shared.Contracts.Enums.Roles.Admin)]

@using RapidRelief.Shared.Contracts.ReadModels
@inject CommandCenterClient Client

<PageTitle>Command Center Overview</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0 fw-bold" style="color: #2c3e50;">Command Center Overview</h1>
    <button class="btn btn-outline-primary" @onclick="LoadDataAsync">
        <i class="bi bi-arrow-clockwise"></i> Refresh
    </button>
</div>

@if (_error != null)
{
    <div class="alert alert-danger shadow-sm d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
        <div>
            <h5 class="alert-heading mb-1">System Degraded</h5>
            <div>@_error</div>
        </div>
    </div>
}
else if (_data == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3 text-muted">Loading system metrics...</p>
    </div>
}
else
{
    <div class="row g-4 mb-4">
        <!-- Incidents Card -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted fw-semibold mb-2">Active Incidents</h6>
                    <h2 class="display-5 fw-bold text-dark mb-2">@_data.TotalActiveIncidents</h2>
                    @if (_data.TotalCriticalIncidents > 0)
                    {
                        <span class="badge bg-danger rounded-pill px-3 py-2">
                            @_data.TotalCriticalIncidents Critical
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success rounded-pill px-3 py-2">
                            0 Critical
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Shelters Card -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted fw-semibold mb-2">Open Shelters</h6>
                    <h2 class="display-5 fw-bold text-dark mb-2">@_data.TotalOpenShelters</h2>
                    @if (_data.TotalShelterCapacity < 100)
                    {
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                            @_data.TotalShelterCapacity beds left
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success rounded-pill px-3 py-2">
                            @_data.TotalShelterCapacity beds left
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Registry Cards -->
        <div class="col-md-12 col-lg-6">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted fw-semibold mb-3">Resource Registry</h6>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="text-center px-3">
                            <h3 class="fw-bold text-primary mb-1">@_data.TotalHospitals</h3>
                            <span class="text-muted small text-uppercase">Hospitals</span>
                        </div>
                        <div class="vr"></div>
                        <div class="text-center px-3">
                            <h3 class="fw-bold text-info mb-1">@_data.TotalNgos</h3>
                            <span class="text-muted small text-uppercase">NGOs</span>
                        </div>
                        <div class="vr"></div>
                        <div class="text-center px-3">
                            <h3 class="fw-bold text-success mb-1">@_data.TotalVolunteers</h3>
                            <span class="text-muted small text-uppercase">Volunteers</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private CommandCenterOverviewDto? _data;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _error = null;
        _data = null;
        StateHasChanged();

        try
        {
            var envelope = await Client.GetOverviewAsync();
            if (envelope != null)
            {
                _data = envelope.Data;
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable)
        {
            _error = "The database is currently unreachable. Dashboard metrics cannot be loaded.";
        }
        catch (Exception ex)
        {
            _error = $"An error occurred while loading data: {ex.Message}";
        }
    }
}
