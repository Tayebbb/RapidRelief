@namespace RapidRelief.Client.Features.Landing.Components
@using RapidRelief.Client.Features.Auth
@inject AuthApi Auth
@inject NavigationManager Navigation

<header class="landing-nav-container" aria-label="Main landing navigation">
    <nav class="landing-nav">
        <a class="nav-brand-group" href="">
            <img src="logo.png" alt="RapidRelief Logo" class="brand-logo-img" style="width: 32px; height: 32px; object-fit: contain;" />
            <span class="nav-brand-text">RapidRelief</span>
        </a>

        <ul class="nav-links-desktop">
            <li><a class="nav-link-item" href="#hero">Home</a></li>
            <li><a class="nav-link-item" href="#quick-actions">Quick Actions</a></li>
            <li><a class="nav-link-item" href="#how-it-works">How It Works</a></li>
            <li><a class="nav-link-item" href="#features">Features</a></li>
            <li><a class="nav-link-item" href="shelters/finder">Shelters</a></li>
            <li><a class="nav-link-item" href="sample">Live Map</a></li>
        </ul>

        <div class="nav-actions">
            <ThemeToggle />

            <AuthorizeView>
                <Authorized>
                    <NotificationBell />

                    <!-- Profile Icon & Dropdown -->
                    <div class="nav-profile-wrapper">
                        <button type="button" class="nav-profile-btn @(_profileMenuOpen ? "is-active" : null)" 
                                @onclick="ToggleProfileMenu" title="Account: @context.User.Identity?.Name" aria-label="Open profile menu">
                            <AppIcon Name="user" Size="18" />
                        </button>

                        @if (_profileMenuOpen)
                        {
                            <div class="nav-profile-backdrop" @onclick="CloseProfileMenu"></div>
                            <div class="nav-profile-dropdown" @onclick:stopPropagation="true">
                                <div class="nav-profile-dropdown-header">
                                    <div class="nav-profile-dropdown-avatar">
                                        <AppIcon Name="user" Size="18" />
                                    </div>
                                    <div class="nav-profile-dropdown-info">
                                        <span class="nav-profile-name">@context.User.Identity?.Name</span>
                                        <span class="nav-profile-role">@UserRole</span>
                                    </div>
                                </div>

                                <div class="nav-profile-dropdown-divider"></div>

                                <a class="nav-profile-item" href="profile" @onclick="CloseProfileMenu">
                                    <AppIcon Name="user" Size="15" />
                                    <span>Profile & Contacts</span>
                                </a>
                                <a class="nav-profile-item" href="notifications" @onclick="CloseProfileMenu">
                                    <AppIcon Name="bell" Size="15" />
                                    <span>Emergency Alerts</span>
                                </a>

                                <div class="nav-profile-dropdown-divider"></div>

                                <button type="button" class="nav-profile-item text-danger" @onclick="SignOutAsync">
                                    <AppIcon Name="logout" Size="15" />
                                    <span>Sign Out</span>
                                </button>
                            </div>
                        }
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="btn-nav-signin" href="auth/signin">
                        Sign In
                    </a>
                    <a class="btn-nav-signup" href="auth/signup">
                        <span>Sign Up</span>
                        <AppIcon Name="arrow-right" Size="15" />
                    </a>
                </NotAuthorized>
            </AuthorizeView>

            <button class="mobile-menu-btn" type="button" @onclick="ToggleMobileMenu"
                    aria-label="@(_mobileOpen ? "Close menu" : "Open menu")" aria-expanded="@_mobileOpen">
                <AppIcon Name="@(_mobileOpen ? "close" : "menu")" Size="22" />
            </button>
        </div>
    </nav>

    @* Mobile dropdown drawer *@
    <div class="mobile-nav-drawer @(_mobileOpen ? "is-open" : null)" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
        <a class="mobile-nav-link" href="#hero" @onclick="CloseMobileMenu">
            <AppIcon Name="home" Size="18" />
            <span>Home</span>
        </a>
        <a class="mobile-nav-link" href="#quick-actions" @onclick="CloseMobileMenu">
            <AppIcon Name="activity" Size="18" />
            <span>Quick Actions</span>
        </a>
        <a class="mobile-nav-link" href="#how-it-works" @onclick="CloseMobileMenu">
            <AppIcon Name="clock" Size="18" />
            <span>How It Works</span>
        </a>
        <a class="mobile-nav-link" href="#features" @onclick="CloseMobileMenu">
            <AppIcon Name="layers" Size="18" />
            <span>Features</span>
        </a>
        <a class="mobile-nav-link" href="shelters/finder" @onclick="CloseMobileMenu">
            <AppIcon Name="map-pin" Size="18" />
            <span>Shelter Finder</span>
        </a>
        <a class="mobile-nav-link" href="sample" @onclick="CloseMobileMenu">
            <AppIcon Name="map" Size="18" />
            <span>Live Map</span>
        </a>

        <div class="pt-2 border-top d-flex flex-column gap-2">
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center gap-2 px-2 py-1 mb-1">
                        <div class="nav-profile-dropdown-avatar" style="width: 30px; height: 30px;">
                            <AppIcon Name="user" Size="16" />
                        </div>
                        <div class="d-flex flex-column">
                            <span class="small fw-bold">@context.User.Identity?.Name</span>
                            <span class="badge bg-success-subtle text-success small" style="width: fit-content; font-size: 0.7rem;">@UserRole</span>
                        </div>
                    </div>
                    <a class="btn btn-outline-secondary btn-sm w-100" href="profile" @onclick="CloseMobileMenu">Profile</a>
                    <button class="btn btn-outline-danger btn-sm w-100" type="button" @onclick="SignOutAsync">Sign Out</button>
                </Authorized>
                <NotAuthorized>
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-secondary btn-sm flex-fill text-center" href="auth/signin" @onclick="CloseMobileMenu">Sign In</a>
                        <a class="btn btn-primary btn-sm flex-fill text-center" href="auth/signup" @onclick="CloseMobileMenu">Sign Up</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

@code {
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    private string UserRole = "Citizen";
    private bool _mobileOpen;
    private bool _profileMenuOpen;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            UserRole = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Citizen";
        }
        catch
        {
            UserRole = "Citizen";
        }
    }

    private void ToggleProfileMenu() => _profileMenuOpen = !_profileMenuOpen;
    private void CloseProfileMenu() => _profileMenuOpen = false;

    private async Task SignOutAsync()
    {
        CloseProfileMenu();
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private void ToggleMobileMenu() => _mobileOpen = !_mobileOpen;
    private void CloseMobileMenu() => _mobileOpen = false;
}
