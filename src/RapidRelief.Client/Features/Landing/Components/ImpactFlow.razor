@namespace RapidRelief.Client.Features.Landing.Components

<section class="landing-section section-white pt-0" aria-label="System Integration Flow">
    <div class="landing-container">
        <div class="impact-flow-track rr-reveal-item">
            <div class="impact-flow-node">
                <div class="telemetry-icon-box">
                    <AppIcon Name="user" Size="20" />
                </div>
                <strong class="small">1. Citizens</strong>
                <span class="rr-meta">Report emergency</span>
            </div>

            <div class="impact-flow-arrow" aria-hidden="true">
                <AppIcon Name="arrow-right" Size="20" />
            </div>

            <div class="impact-flow-node">
                <div class="telemetry-icon-box is-emergency">
                    <AppIcon Name="activity" Size="20" />
                </div>
                <strong class="small">2. Incident Telemetry</strong>
                <span class="rr-meta">GPS &amp; Photos captured</span>
            </div>

            <div class="impact-flow-arrow" aria-hidden="true">
                <AppIcon Name="arrow-right" Size="20" />
            </div>

            <div class="impact-flow-node">
                <div class="telemetry-icon-box is-intelligence">
                    <AppIcon Name="sparkles" Size="20" />
                </div>
                <strong class="small">3. AI Triage Engine</strong>
                <span class="rr-meta">Scoring &amp; deduplication</span>
            </div>

            <div class="impact-flow-arrow" aria-hidden="true">
                <AppIcon Name="arrow-right" Size="20" />
            </div>

            <div class="impact-flow-node">
                <div class="telemetry-icon-box">
                    <AppIcon Name="shield" Size="20" />
                </div>
                <strong class="small">4. Response &amp; Recovery</strong>
                <span class="rr-meta">Teams, Shelters, Aid</span>
            </div>
        </div>
    </div>
</section>
