@namespace RapidRelief.Client.Features.Landing.Components

<section class="landing-section section-white pt-0" aria-label="System Integration Flow">
    <div class="landing-container">
        <div class="impact-flow-track rr-reveal-item">
            <div class="impact-flow-node">
                <div class="telemetry-icon-box">
                    <AppIcon Name="user" Size="20" />
                </div>
                <strong class="small">1. Citizens</strong>
                <span class="text-muted" style="font-size: 0.78rem;">Report emergency</span>
            </div>

            <div class="impact-flow-arrow" aria-hidden="true">
                <AppIcon Name="arrow-right" Size="20" />
            </div>

            <div class="impact-flow-node">
                <div class="telemetry-icon-box" style="background: var(--rr-rescue-red-soft); color: var(--rr-rescue-red);">
                    <AppIcon Name="activity" Size="20" />
                </div>
                <strong class="small">2. Incident Telemetry</strong>
                <span class="text-muted" style="font-size: 0.78rem;">GPS & Photos captured</span>
            </div>

            <div class="impact-flow-arrow" aria-hidden="true">
                <AppIcon Name="arrow-right" Size="20" />
            </div>

            <div class="impact-flow-node">
                <div class="telemetry-icon-box" style="background: var(--rr-forest-light); color: var(--rr-forest);">
                    <AppIcon Name="sparkles" Size="20" />
                </div>
                <strong class="small">3. AI Triage Engine</strong>
                <span class="text-muted" style="font-size: 0.78rem;">Scoring & deduplication</span>
            </div>

            <div class="impact-flow-arrow" aria-hidden="true">
                <AppIcon Name="arrow-right" Size="20" />
            </div>

            <div class="impact-flow-node">
                <div class="telemetry-icon-box">
                    <AppIcon Name="shield" Size="20" />
                </div>
                <strong class="small">4. Response & Recovery</strong>
                <span class="text-muted" style="font-size: 0.78rem;">Teams, Shelters, Aid</span>
            </div>
        </div>
    </div>
</section>
