@namespace RapidRelief.Client.Features.Landing.Components

<section id="how-it-works" class="landing-section section-sage-mist" aria-labelledby="how-it-works-title">
    <div class="landing-container">
        <div class="section-header-center rr-reveal-item">
            <span class="section-tag">
                <AppIcon Name="clock" Size="13" />
                <span>Response Lifecycle</span>
            </span>
            <h2 id="how-it-works-title" class="section-title">From emergency to response.</h2>
            <p class="section-subtitle">
                A transparent, reliable 4-step workflow connecting citizens with rescue operators during critical hours.
            </p>
        </div>

        <div class="how-it-works-grid">
            <div class="step-card rr-reveal-item delay-1">
                <div class="step-number-badge">01</div>
                <h3 class="step-title">Report</h3>
                <p class="step-desc">
                    A citizen reports an incident or sends an SOS with location coordinates and photo evidence — queued offline if networks fail.
                </p>
            </div>

            <div class="step-card rr-reveal-item delay-2">
                <div class="step-number-badge">02</div>
                <h3 class="step-title">Understand</h3>
                <p class="step-desc">
                    The system classifies the emergency, calculates a 1–5 severity score, and flags duplicate reports so responders focus on genuine needs.
                </p>
            </div>

            <div class="step-card rr-reveal-item delay-3">
                <div class="step-number-badge">03</div>
                <h3 class="step-title">Respond</h3>
                <p class="step-desc">
                    Emergency operators and rescue teams receive prioritized dispatch missions with direct route navigation and real-time status syncing.
                </p>
            </div>

            <div class="step-card rr-reveal-item delay-4">
                <div class="step-number-badge">04</div>
                <h3 class="step-title">Recover</h3>
                <p class="step-desc">
                    Evacuees find open shelters with live capacity, relief supplies are allocated transparently, and communities stay informed.
                </p>
            </div>
        </div>
    </div>
</section>
