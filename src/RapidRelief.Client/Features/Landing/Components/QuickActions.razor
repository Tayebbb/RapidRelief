@namespace RapidRelief.Client.Features.Landing.Components

<section id="quick-actions" class="landing-section section-white" aria-labelledby="quick-actions-title">
    <div class="landing-container">
        <div class="section-header-center rr-reveal-item">
            <span class="section-tag">
                <AppIcon Name="activity" Size="13" />
                <span>Immediate Support</span>
            </span>
            <h2 id="quick-actions-title" class="section-title">What do you need right now?</h2>
            <p class="section-subtitle">
                Fast, direct access to essential emergency tools for citizens, families, and first responders.
            </p>
        </div>

        <div class="quick-actions-grid">
            <a class="quick-card card-emergency rr-reveal-item delay-1" href="shelters/finder">
                <div>
                    <div class="quick-card-icon">
                        <AppIcon Name="phone" Size="24" />
                    </div>
                    <h3 class="quick-card-title">Report an Emergency</h3>
                    <p class="quick-card-desc">
                        Send an urgent incident report with location coordinates and details rescue teams need to dispatch aid.
                    </p>
                </div>
                <div class="quick-card-cta">
                    <span>Report Now</span>
                    <AppIcon Name="arrow-right" Size="15" />
                </div>
            </a>

            <a class="quick-card rr-reveal-item delay-2" href="shelters/finder">
                <div>
                    <div class="quick-card-icon">
                        <AppIcon Name="map-pin" Size="24" />
                    </div>
                    <h3 class="quick-card-title">Find a Safe Shelter</h3>
                    <p class="quick-card-desc">
                        Locate nearby verified shelters, check real-time bed capacity, and get smart distance-ranked directions.
                    </p>
                </div>
                <div class="quick-card-cta">
                    <span>Find Shelter</span>
                    <AppIcon Name="arrow-right" Size="15" />
                </div>
            </a>

            <a class="quick-card rr-reveal-item delay-3" href="assistant">
                <div>
                    <div class="quick-card-icon">
                        <AppIcon Name="chat" Size="24" />
                    </div>
                    <h3 class="quick-card-title">Emergency Assistant</h3>
                    <p class="quick-card-desc">
                        Receive instant, calm safety guidance tailored to your specific situation — floods, fires, or building collapses.
                    </p>
                </div>
                <div class="quick-card-cta">
                    <span>Ask Assistant</span>
                    <AppIcon Name="arrow-right" Size="15" />
                </div>
            </a>

            <a class="quick-card rr-reveal-item delay-4" href="sample">
                <div>
                    <div class="quick-card-icon">
                        <AppIcon Name="map" Size="24" />
                    </div>
                    <h3 class="quick-card-title">Live Incident Map</h3>
                    <p class="quick-card-desc">
                        Explore reported emergencies and operational relief hubs across Dhaka on an interactive, live-updating map.
                    </p>
                </div>
                <div class="quick-card-cta">
                    <span>View Map</span>
                    <AppIcon Name="arrow-right" Size="15" />
                </div>
            </a>
        </div>
    </div>
</section>
