@namespace RapidRelief.Client.Features.Landing.Components

<section id="features" class="landing-section section-warm-ivory" aria-labelledby="features-title">
    <div class="landing-container">
        <div class="section-header-center rr-reveal-item">
            <span class="section-tag">
                <AppIcon Name="layers" Size="13" />
                <span>Platform Capabilities</span>
            </span>
            <h2 id="features-title" class="section-title">Engineered for resilience under pressure.</h2>
            <p class="section-subtitle">
                Core technologies designed to remain functional, clear, and actionable during city-wide emergencies.
            </p>
        </div>

        <div class="features-bento">
            <div class="bento-card bento-span-2 rr-reveal-item delay-1">
                <div>
                    <div class="bento-icon-wrapper">
                        <AppIcon Name="map-pin" Size="22" />
                    </div>
                    <h3 class="bento-title">Smart Disaster Reporting & Offline Queue</h3>
                    <p class="bento-desc">
                        Report emergencies with pinpoint GPS coordinates and photo evidence in seconds. If the mobile network drops, reports are stored safely on the device and sync automatically as soon as a connection is detected.
                    </p>
                </div>
                <div class="pt-3">
                    <span class="badge bg-light text-dark border me-2">GPS Coordinates</span>
                    <span class="badge bg-light text-dark border me-2">Photo Upload</span>
                    <span class="badge bg-light text-dark border">Offline Resilience</span>
                </div>
            </div>

            <div class="bento-card rr-reveal-item delay-2">
                <div>
                    <div class="bento-icon-wrapper">
                        <AppIcon Name="sparkles" Size="22" />
                    </div>
                    <h3 class="bento-title">AI Triage & Severity Scoring</h3>
                    <p class="bento-desc">
                        Automated classification scores incident severity 1–5 and detects near-duplicate reports. A deterministic rule-based fallback guarantees triage never stops even if external AI APIs become unreachable.
                    </p>
                </div>
                <div class="pt-3">
                    <span class="badge bg-light text-dark border">100% Uptime Fallback</span>
                </div>
            </div>

            <div class="bento-card rr-reveal-item delay-3">
                <div>
                    <div class="bento-icon-wrapper">
                        <AppIcon Name="home" Size="22" />
                    </div>
                    <h3 class="bento-title">Live Shelter Capacity Telemetry</h3>
                    <p class="bento-desc">
                        Monitor verified shelters across Dhaka with live occupancy rates, available bed counts, and distance-ranked routing so displaced families find safe harbor without delays.
                    </p>
                </div>
                <div class="pt-3">
                    <span class="badge bg-light text-dark border">Live Occupancy</span>
                </div>
            </div>

            <div class="bento-card bento-span-2 rr-reveal-item delay-4">
                <div>
                    <div class="bento-icon-wrapper">
                        <AppIcon Name="shield" Size="22" />
                    </div>
                    <h3 class="bento-title">Rescue Coordination & Team Dispatch</h3>
                    <p class="bento-desc">
                        Rescue squads receive verified mission assignments with sector coordinates, victim status, and route navigation — synchronizing volunteer teams and emergency services on one operational map.
                    </p>
                </div>
                <div class="pt-3">
                    <span class="badge bg-light text-dark border me-2">Field Missions</span>
                    <span class="badge bg-light text-dark border me-2">Team Sync</span>
                    <span class="badge bg-light text-dark border">Role Authorization</span>
                </div>
            </div>
        </div>
    </div>
</section>
