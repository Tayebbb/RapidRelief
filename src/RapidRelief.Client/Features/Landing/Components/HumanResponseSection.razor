@namespace RapidRelief.Client.Features.Landing.Components

<section id="community" class="landing-section section-warm-ivory" aria-labelledby="human-title">
    <div class="landing-container">
        <div class="section-header-center rr-reveal-item">
            <span class="section-tag">
                <AppIcon Name="user" Size="13" />
                <span>Community & Responders</span>
            </span>
            <h2 id="human-title" class="section-title">Technology built around people.</h2>
            <p class="section-subtitle">
                Software and algorithms don't save lives on their own — dedicated people do. RapidRelief connects and equips every link in the humanitarian chain.
            </p>
        </div>

        <div class="human-pillars-grid">
            <div class="human-pillar-card rr-reveal-item delay-1">
                <div class="human-pillar-icon">
                    <AppIcon Name="shield" Size="26" />
                </div>
                <h3 class="h5 fw-bold mb-2">First Responders</h3>
                <p class="text-muted small mb-0">
                    Equips emergency response squads with clean incident data, verified GPS routes, and coordinated sector assignments so teams focus on saving lives.
                </p>
            </div>

            <div class="human-pillar-card rr-reveal-item delay-2">
                <div class="human-pillar-icon">
                    <AppIcon Name="activity" Size="26" />
                </div>
                <h3 class="h5 fw-bold mb-2">Local Volunteers</h3>
                <p class="text-muted small mb-0">
                    Enables registered neighborhood volunteers to assist in evacuation, food distribution, and non-critical aid missions with verified safety guidelines.
                </p>
            </div>

            <div class="human-pillar-card rr-reveal-item delay-3">
                <div class="human-pillar-icon">
                    <AppIcon Name="home" Size="26" />
                </div>
                <h3 class="h5 fw-bold mb-2">Shelter Operators</h3>
                <p class="text-muted small mb-0">
                    Provides relief hubs and shelter managers with real-time intake logging, supply request triggers, and capacity synchronization across the city.
                </p>
            </div>
        </div>
    </div>
</section>
