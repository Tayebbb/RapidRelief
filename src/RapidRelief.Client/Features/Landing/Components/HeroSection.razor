@namespace RapidRelief.Client.Features.Landing.Components

<section id="hero" class="landing-hero" aria-labelledby="hero-main-title">
    <div class="hero-ambient-glow" aria-hidden="true"></div>

    <div class="hero-content-wrap">
        <div class="hero-content-inner">
            <h1 id="hero-main-title" class="hero-headline">
                Help reaches people when it matters most.
            </h1>

            <p class="hero-lede">
                Report emergencies, locate verified shelters, receive immediate safety guidance, and coordinate rescue missions across Dhaka — engineered to work offline when cellular networks fail.
            </p>

            <div class="hero-actions-group">
                <a class="btn-hero-primary" href="reports/new">
                    <span>Report an Emergency</span>
                    <AppIcon Name="arrow-right" Size="16" />
                </a>
                <a class="btn-hero-secondary" href="livemap">
                    <AppIcon Name="map" Size="16" />
                    <span>Explore Live Map</span>
                </a>
                <a class="btn-hero-tertiary" href="shelter">
                    <AppIcon Name="map-pin" Size="16" />
                    <span>Find Shelters</span>
                </a>
            </div>

            <!-- Apple / Notion Style Live Emergency Status Console -->
            <div class="hero-console-card rr-reveal-item">
                <div class="console-head">
                    <div class="console-status-indicator">
                        <span class="console-pulse-dot" aria-hidden="true"></span>
                        <span class="console-status-text">Dhaka Emergency Response Grid · Operational</span>
                    </div>
                    <div class="console-emergency-tag">
                        <AppIcon Name="phone" Size="13" />
                        <span>Life-threatening crisis? Dial <strong>999</strong></span>
                    </div>
                </div>

                <div class="console-body">
                    <div class="console-metric">
                        <span class="console-metric-label">Verified Shelters</span>
                        <strong class="console-metric-val">24 Active</strong>
                        <span class="console-metric-sub">1,840 available spaces</span>
                    </div>
                    <div class="console-metric-divider" aria-hidden="true"></div>
                    <div class="console-metric">
                        <span class="console-metric-label">Field Rescue Teams</span>
                        <strong class="console-metric-val">12 Deployed</strong>
                        <span class="console-metric-sub">Coordinated via GPS</span>
                    </div>
                    <div class="console-metric-divider" aria-hidden="true"></div>
                    <div class="console-metric">
                        <span class="console-metric-label">Offline Reliability</span>
                        <strong class="console-metric-val">100% Guaranteed</strong>
                        <span class="console-metric-sub">Local IndexedDB outbox</span>
                    </div>
                </div>

                <div class="console-foot">
                    <span class="console-foot-label">Quick Jump:</span>
                    <div class="console-foot-links">
                        <a class="console-quick-link" href="reports/new">
                            <AppIcon Name="alert-circle" Size="14" />
                            <span>File Incident</span>
                        </a>
                        <a class="console-quick-link" href="shelter">
                            <AppIcon Name="home" Size="14" />
                            <span>Shelter Telemetry</span>
                        </a>
                        <a class="console-quick-link" href="relief/request">
                            <AppIcon Name="shield-plus" Size="14" />
                            <span>Request Aid</span>
                        </a>
                        <a class="console-quick-link" href="assistant">
                            <AppIcon Name="chat" Size="14" />
                            <span>AI Field Guide</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

