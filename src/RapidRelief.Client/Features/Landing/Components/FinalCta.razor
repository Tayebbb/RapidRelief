@namespace RapidRelief.Client.Features.Landing.Components

<section class="final-cta-section" aria-labelledby="cta-heading">
    <div class="landing-container">
        <div class="rr-reveal-item">
            <h2 id="cta-heading" class="final-cta-title">
                When every second matters,<br />
                the right information matters too.
            </h2>
            <p class="final-cta-lede">
                Join RapidRelief to help build a faster, better-coordinated, and resilient disaster response network for our communities.
            </p>

            <div class="final-cta-btns">
                <a class="btn-cta-white" href="register">
                    <span>Create a Citizen Account</span>
                    <AppIcon Name="arrow-right" Size="16" />
                </a>
                <a class="btn-cta-outline-white" href="sample">
                    <AppIcon Name="map" Size="16" />
                    <span>View Live Incident Map</span>
                </a>
                <a class="btn-cta-outline-white" href="shelters/finder">
                    <AppIcon Name="map-pin" Size="16" />
                    <span>Find Open Shelters</span>
                </a>
            </div>
        </div>
    </div>
</section>
