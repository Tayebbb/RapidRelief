@using RapidRelief.Client.Common.Map
@using RapidRelief.Shared.Contracts.Common
@using RapidRelief.Shared.Contracts.ReadModels

<RapidMap View="_map" InitialCenter="MapCenter" InitialZoom="13" />

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ShelterSummaryDto> Shelters { get; set; } = [];

    [Parameter]
    public GeoPoint? Center { get; set; }

    [Parameter]
    public GeoPoint? UserLocation { get; set; }

    [Parameter]
    public double UserAccuracyMeters { get; set; }

    private readonly MapView _map = new();

    private GeoPoint MapCenter => Center ?? _map.FallbackCenter;

    protected override void OnParametersSet()
    {
        // The shared adapter decides the pin style and the "N of M free" label, so a shelter
        // looks and reads the same here as it does on the operational map.
        _map.SetLayer(MapLayerId.Shelters, Shelters.ToPlacemarks());
        _map.UserLocation = UserLocation;
        _map.UserLocationAccuracyMeters = UserAccuracyMeters;
    }
}
