@page "/shelters/finder"
@using RapidRelief.Shared.Contracts.Common
@using RapidRelief.Shared.Contracts.ReadModels
@using RapidRelief.Client.Common.Ui
@using RapidRelief.Client.Features.Shelters.Components
@inject SheltersClient Client
@inject GeolocationService Geo

<PageTitle>Find shelter — RapidRelief</PageTitle>

<h1>Nearest Shelters</h1>

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}
@if (_geoNote is not null)
{
    <div class="alert alert-warning" role="alert">
        @_geoNote Showing shelters near central Dhaka instead.
        <button class="btn btn-sm btn-outline-secondary ms-2" type="button" @onclick="RetryLocateAsync"
                disabled="@_locating">Try again</button>
    </div>
}

<div class="row">
    <div class="col-md-4">
        @if (_locating)
        {
            <p aria-live="polite"><em>Determining your location…</em></p>
        }
        else if (_shelters is null && _error is null)
        {
            <div class="rr-skeleton-group" aria-busy="true" aria-label="Loading shelters">
                <div class="rr-skeleton rr-skeleton-rect"></div>
                <div class="rr-skeleton rr-skeleton-rect"></div>
                <div class="rr-skeleton rr-skeleton-rect"></div>
            </div>
        }
        else if (_shelters is not null)
        {
            @if (_recommendations.Count == 0)
            {
                <div class="alert alert-warning">
                    No open shelter with free space was found near you. Call <strong>999</strong> for guidance.
                </div>
            }
            else
            {
                <h2 class="h6 text-uppercase text-secondary mb-2">Best for you right now</h2>
                @for (var i = 0; i < _recommendations.Count; i++)
                {
                    var rec = _recommendations[i];
                    <div class="card mb-3 @(i == 0 ? "border-success" : "")">
                        @if (i == 0)
                        {
                            <div class="card-header bg-success text-white d-flex align-items-center justify-content-between">
                                <strong>Recommended</strong>
                                <span>@rec.DistanceKm.ToString("F1") km</span>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title mb-1">@rec.Name</h5>
                            <p class="card-text mb-2 small text-secondary">
                                @string.Join(" · ", rec.Reasons)
                            </p>
                            <div class="progress mb-2" style="height: 6px;" role="progressbar"
                                 aria-label="Occupancy" aria-valuenow="@rec.OccupancyPercent" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar @(rec.OccupancyPercent >= 85 ? "bg-danger" : "bg-success")"
                                     style="width: @(rec.OccupancyPercent)%"></div>
                            </div>
                            <p class="card-text mb-2 small">
                                @rec.Occupancy / @rec.Capacity people · <strong>@rec.FreeSpaces free</strong>
                                @if (rec.Facilities.Count > 0)
                                {
                                    <text> · @string.Join(", ", rec.Facilities)</text>
                                }
                            </p>
                            <a href="https://www.google.com/maps/dir/?api=1&destination=@rec.Location.Latitude,@rec.Location.Longitude"
                               target="_blank" rel="noopener" class="btn btn-sm @(i == 0 ? "btn-success" : "btn-outline-secondary")">
                                Directions
                            </a>
                        </div>
                    </div>
                }
            }

            <h2 class="h6 text-uppercase text-secondary mb-2">All shelters</h2>
            @if (_shelters.Count == 0)
            {
                <div class="rr-empty">
                    <AppIcon Name="home" Size="28" />
                    <strong>No shelters are listed yet.</strong>
                    <span>Call <strong>999</strong> for guidance on where to go.</span>
                </div>
            }
            else
            {
            <ul class="list-group">
                @foreach (var shelter in _shelters)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0">@shelter.Name</h6>
                            <small class="text-muted">
                                @if (shelter.IsOpen)
                                {
                                    <span class="text-success">Open</span>
                                }
                                else
                                {
                                    <span class="text-danger">Closed</span>
                                }
                                • @shelter.Occupancy / @shelter.Capacity
                                @if (shelter.Capacity > 0 && shelter.Occupancy >= shelter.Capacity)
                                {
                                    <span class="text-danger"> • full</span>
                                }
                            </small>
                        </div>
                        <a href="https://www.google.com/maps/dir/?api=1&destination=@shelter.Location.Latitude,@shelter.Location.Longitude"
                           target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">
                            Directions
                        </a>
                    </li>
                }
            </ul>
            }
        }
    </div>
    <div class="col-md-8">
        @* Fixed 600px overflowed short phones; cap against the viewport instead. *@
        <div style="height: min(600px, calc(100vh - 220px)); min-height: 320px;">
            @if (_shelters is not null)
            {
                <ShelterMapLayer Shelters="_shelters" Center="_userLocation" UserLocation="_gpsFix"
                                 UserAccuracyMeters="_gpsAccuracy" />
            }
        </div>
    </div>
</div>

@code {
    private static readonly GeoPoint DhakaFallback = new(23.8103, 90.4125);

    private bool _locating = true;
    private GeoPoint? _userLocation;
    private GeoPoint? _gpsFix;
    private double _gpsAccuracy;
    private string? _geoNote;
    private List<ShelterSummaryDto>? _shelters;
    private List<ShelterRecommendationDto> _recommendations = new();
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LocateAsync();
            await LoadDataAsync();
        }
    }

    private async Task LocateAsync()
    {
        _locating = true;
        StateHasChanged();

        var fix = await Geo.GetCurrentAsync();
        if (fix.Ok)
        {
            _gpsFix = fix.Point;
            _gpsAccuracy = fix.AccuracyMeters;
            _userLocation = fix.Point;
            _geoNote = null;
        }
        else
        {
            _gpsFix = null;
            _userLocation = DhakaFallback;
            _geoNote = fix.Message;
        }

        _locating = false;
        StateHasChanged();
    }

    private async Task RetryLocateAsync()
    {
        await LocateAsync();
        if (_gpsFix is not null)
        {
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        if (_userLocation == null) return;

        try
        {
            // 1. Fetch nearest shelters
            var sheltersResult = await Client.GetSheltersAsync(_userLocation.Latitude, _userLocation.Longitude);
            if (sheltersResult != null)
            {
                _shelters = sheltersResult.Data.Items.ToList();
            }

            // 2. Rank by suitability (distance + free capacity + facilities), not distance alone.
            _recommendations = (await Client.GetRecommendationsAsync(
                _userLocation.Latitude, _userLocation.Longitude, count: 3)).ToList();
        }
        catch (HttpRequestException)
        {
            _error = "Could not reach the server to fetch shelters.";
        }

        StateHasChanged();
    }
}
