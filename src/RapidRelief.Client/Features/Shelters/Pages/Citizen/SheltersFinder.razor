@page "/shelters/finder"
@using RapidRelief.Shared.Contracts.Common
@using RapidRelief.Shared.Contracts.ReadModels
@using RapidRelief.Client.Features.Shelters.Components
@inject SheltersClient Client
@inject GeolocationService Geo

<PageTitle>Find Shelter</PageTitle>

<h1>Nearest Shelters</h1>

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}
@if (_geoNote is not null)
{
    <div class="alert alert-warning" role="alert">
        @_geoNote Showing shelters near central Dhaka instead.
        <button class="btn btn-sm btn-outline-secondary ms-2" type="button" @onclick="RetryLocateAsync"
                disabled="@_locating">Try again</button>
    </div>
}

<div class="row">
    <div class="col-md-4">
        @if (_locating)
        {
            <p><em>Determining your location...</em></p>
        }
        else if (_shelters is null && _error is null)
        {
            <p><em>Loading shelters...</em></p>
        }
        else if (_shelters is not null)
        {
            @if (_recommendedShelter is null)
            {
                <div class="alert alert-info">No AI recommendation available at this time.</div>
            }
            else
            {
                <div class="card border-success mb-3">
                    <div class="card-header bg-success text-white">
                        <strong>Recommended for you</strong>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">@_recommendedShelter.Name</h5>
                        <p class="card-text mb-1">
                            Occupancy: @_recommendedShelter.Occupancy / @_recommendedShelter.Capacity
                        </p>
                        <a href="https://www.google.com/maps/search/?api=1&query=@_recommendedShelter.Location.Latitude,@_recommendedShelter.Location.Longitude"
                           target="_blank" class="btn btn-sm btn-success">
                            Get Directions
                        </a>
                    </div>
                </div>
            }

            <ul class="list-group">
                @foreach (var shelter in _shelters)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0">@shelter.Name</h6>
                            <small class="text-muted">
                                @if (shelter.IsOpen)
                                {
                                    <span class="text-success">Open</span>
                                }
                                else
                                {
                                    <span class="text-danger">Closed</span>
                                }
                                • @shelter.Occupancy / @shelter.Capacity
                            </small>
                        </div>
                        <a href="https://www.google.com/maps/search/?api=1&query=@shelter.Location.Latitude,@shelter.Location.Longitude"
                           target="_blank" class="btn btn-sm btn-outline-primary">
                            Directions
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
    <div class="col-md-8">
        <div style="height: 600px;">
            @if (_shelters is not null)
            {
                <ShelterMapLayer Shelters="_shelters" Center="_userLocation" UserLocation="_gpsFix"
                                 UserAccuracyMeters="_gpsAccuracy" />
            }
        </div>
    </div>
</div>

@code {
    private static readonly GeoPoint DhakaFallback = new(23.8103, 90.4125);

    private bool _locating = true;
    private GeoPoint? _userLocation;
    private GeoPoint? _gpsFix;
    private double _gpsAccuracy;
    private string? _geoNote;
    private List<ShelterSummaryDto>? _shelters;
    private ShelterSummaryDto? _recommendedShelter;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LocateAsync();
            await LoadDataAsync();
        }
    }

    private async Task LocateAsync()
    {
        _locating = true;
        StateHasChanged();

        var fix = await Geo.GetCurrentAsync();
        if (fix.Ok)
        {
            _gpsFix = fix.Point;
            _gpsAccuracy = fix.AccuracyMeters;
            _userLocation = fix.Point;
            _geoNote = null;
        }
        else
        {
            _gpsFix = null;
            _userLocation = DhakaFallback;
            _geoNote = fix.Message;
        }

        _locating = false;
        StateHasChanged();
    }

    private async Task RetryLocateAsync()
    {
        await LocateAsync();
        if (_gpsFix is not null)
        {
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        if (_userLocation == null) return;

        try
        {
            // 1. Fetch nearest shelters
            var sheltersResult = await Client.GetSheltersAsync(_userLocation.Latitude, _userLocation.Longitude);
            if (sheltersResult != null)
            {
                _shelters = sheltersResult.Data.Items.ToList();
            }

            // 2. Fetch AI recommendation
            var recResult = await Client.RecommendShelterAsync(_userLocation.Latitude, _userLocation.Longitude);
            if (recResult != null)
            {
                _recommendedShelter = recResult.Data;
            }
        }
        catch (HttpRequestException)
        {
            _error = "Could not reach the server to fetch shelters.";
        }

        StateHasChanged();
    }
}
