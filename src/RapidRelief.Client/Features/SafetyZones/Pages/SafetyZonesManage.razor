    private static string ZoneTypeChip(ZoneType type) => type switch
    {
        ZoneType.DangerZone => "rr-chip-danger",
        ZoneType.EvacuationZone => "rr-chip-danger",
        ZoneType.SafeAssemblyPoint => "rr-chip-success",
        ZoneType.RestrictedArea => "rr-chip-warning",
        _ => ""
    };

    private static string SeverityChip(Severity severity) => severity switch
    {
        Severity.Catastrophic => "rr-chip-danger",
        Severity.Severe => "rr-chip-danger",
        Severity.Moderate => "rr-chip-warning",
        _ => "rr-chip-info"
    };

    public void Dispose()
    {
        _liveSub?.Dispose();
    }
