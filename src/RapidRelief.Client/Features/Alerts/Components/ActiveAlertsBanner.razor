@namespace RapidRelief.Client.Features.Alerts.Components
@using RapidRelief.Client.Features.Alerts
@inject IAlertsApi AlertsApi

@if (_alerts is { Count: > 0 })
{
    <section class="alert alert-danger d-flex gap-3 align-items-start shadow-sm" role="alert" aria-labelledby="active-alerts-title">
        <AppIcon Name="alert-circle" Size="24" />
        <div class="flex-grow-1">
            <h2 id="active-alerts-title" class="h5 mb-2">Active emergency alerts</h2>
            @foreach (var alert in _alerts)
            {
                <article class="mb-3 last-alert-item">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <strong>@alert.Title</strong>
                        <span class="rr-chip rr-chip-danger">@alert.Severity</span>
                    </div>
                    <p class="mb-1 mt-1">@alert.Body</p>
                    <small>Area: @alert.TargetArea · Until @alert.ExpiresAtUtc.ToLocalTime().ToString("g")</small>
                </article>
            }
            <a class="btn btn-danger btn-sm" href="notifications">Open alert inbox</a>
        </div>
    </section>
}

@code {
    private List<AlertDto>? _alerts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _alerts = (await AlertsApi.GetActiveAsync()).ToList();
        }
        catch (HttpRequestException)
        {
            _alerts = [];
        }
    }
}
