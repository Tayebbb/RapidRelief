@page "/sample"
@using RapidRelief.Shared.Contracts.Common
@using RapidRelief.Shared.Contracts.ReadModels
@inject HttpClient Http

<PageTitle>Live map — RapidRelief</PageTitle>

<div class="rr-page">
    <header class="rr-page-head rr-reveal">
        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
            <h1 class="mb-0">Live map &amp; sample slice</h1>
            <span class="rr-chip">Developer sandbox</span>
        </div>
        <p class="rr-page-lede">
            The F0 copy-me slice: seeded Dhaka incidents on the shared map, plus a ping form that posts
            with the role selected in the header picker (sent as <code>X-Dev-Role</code>).
        </p>
    </header>

    @if (_degradedNotice is not null)
    {
        <div class="alert alert-warning" role="alert">@_degradedNotice</div>
    }

    <section class="rr-card rr-section rr-reveal rr-reveal-1">
        <h2>Dhaka incident map</h2>
        <p class="rr-field-help mb-3">
            Seeded stub incidents from <code>GET /api/foundation/demo-incidents</code> — served by
            <code>IIncidentReadService</code> (the fake until F2 lands).
        </p>

        @if (_mapNotice is not null)
        {
            <div class="alert alert-warning" role="alert">@_mapNotice</div>
        }

        <RapidMap InitialCenter="@(new GeoPoint(23.8103, 90.4125))" InitialZoom="11" Markers="_markers" OnMapClick="OnMapClicked" />

        @if (_lastClicked is not null)
        {
            <p class="rr-field-help mt-2 mb-0">
                Map clicked at @_lastClicked.Latitude.ToString("F4"), @_lastClicked.Longitude.ToString("F4") —
                click-to-pin wiring works.
            </p>
        }
    </section>

    <section class="rr-card rr-section rr-reveal rr-reveal-2">
        <h2>Post a ping</h2>
        <p class="rr-field-help mb-3">Only <code>Admin</code> may post — flip the role picker to see 401/403.</p>
        <form @onsubmit="PostPingAsync" @onsubmit:preventDefault>
            <label class="form-label" for="ping-message">Message</label>
            <div class="d-flex gap-2 flex-wrap">
                <input id="ping-message" class="form-control flex-grow-1" style="max-width: 26rem;"
                       @bind="_message" @bind:event="oninput" placeholder="e.g. hello RapidRelief" />
                <button class="btn btn-primary" type="submit" disabled="@_posting">
                    @(_posting ? "Posting…" : "Post ping")
                </button>
            </div>
            @if (_validationErrors.Count > 0)
            {
                <ul class="rr-field-error mt-2">
                    @foreach (var error in _validationErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            }
        </form>
    </section>

    <section class="rr-section rr-reveal rr-reveal-3">
        <h2>Recent pings</h2>
        @if (_pings is null)
        {
            <div class="rr-card" aria-busy="true" aria-label="Loading pings">
                <span class="rr-skeleton" style="width: 100%; height: 1rem; margin-bottom: 0.6rem;"></span>
                <span class="rr-skeleton" style="width: 85%; height: 1rem; margin-bottom: 0.6rem;"></span>
                <span class="rr-skeleton" style="width: 70%; height: 1rem;"></span>
            </div>
        }
        else if (_pings.Count == 0)
        {
            <div class="rr-empty">
                <AppIcon Name="activity" Size="26" />
                <strong>No pings yet</strong>
                <p>Post the first one above — with the Admin role selected in the header.</p>
            </div>
        }
        else
        {
            <div class="rr-table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Message</th>
                            <th>Created (UTC)</th>
                            <th>Id</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ping in _pings)
                        {
                            <tr>
                                <td>@ping.Message</td>
                                <td>@ping.CreatedAtUtc.ToString("u")</td>
                                <td><code>@ping.Id</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private string _message = string.Empty;
    private bool _posting;
    private string? _degradedNotice;
    private string? _mapNotice;
    private List<PingModel>? _pings;
    private IReadOnlyList<MapMarker> _markers = [];
    private GeoPoint? _lastClicked;
    private readonly List<string> _validationErrors = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadPingsAsync();
        await LoadIncidentMarkersAsync();
    }

    private async Task LoadIncidentMarkersAsync()
    {
        try
        {
            var envelope = await Http.GetFromJsonAsync<ApiEnvelope<PagedResult<IncidentSummaryDto>>>(
                "api/foundation/demo-incidents");
            _markers = envelope?.Data.Items
                .Select(i => new MapMarker(
                    i.Id.ToString(),
                    i.Location.Latitude,
                    i.Location.Longitude,
                    $"{i.Type} ({i.Severity}) — {i.Summary}",
                    i.IsSos ? "SOS" : i.Status.ToString()))
                .ToList() ?? [];
            _mapNotice = null;
        }
        catch (HttpRequestException)
        {
            _mapNotice = "Could not load seeded incidents — is the API running?";
        }
    }

    private void OnMapClicked(GeoPoint point)
    {
        _lastClicked = point;
        StateHasChanged();
    }

    private async Task LoadPingsAsync()
    {
        try
        {
            var response = await Http.GetAsync("api/sample/pings");
            if (response.IsSuccessStatusCode)
            {
                var envelope = await response.Content.ReadFromJsonAsync<ApiEnvelope<PagedResult<PingModel>>>();
                _pings = envelope?.Data.Items.ToList() ?? [];
                _degradedNotice = null;
            }
            else
            {
                _pings = [];
                _degradedNotice = await ReadProblemAsync(response, "Could not load pings.");
            }
        }
        catch (HttpRequestException)
        {
            _pings = [];
            _degradedNotice = "API unreachable — is the server running?";
        }
    }

    private async Task PostPingAsync()
    {
        _posting = true;
        _validationErrors.Clear();
        try
        {
            // X-Dev-Role comes from the shared DevRoleHandler, driven by the top-bar picker.
            var response = await Http.PostAsJsonAsync("api/sample/pings", new { message = _message });
            if (response.IsSuccessStatusCode)
            {
                _message = string.Empty;
                await LoadPingsAsync();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                var problem = await response.Content.ReadFromJsonAsync<ProblemModel>();
                _validationErrors.AddRange(
                    problem?.Errors?.SelectMany(kvp => kvp.Value) ?? ["Invalid request."]);
            }
            else
            {
                _validationErrors.Add(await ReadProblemAsync(response, $"Post failed ({(int)response.StatusCode})."));
            }
        }
        catch (HttpRequestException)
        {
            _validationErrors.Add("API unreachable — is the server running?");
        }
        finally
        {
            _posting = false;
        }
    }

    private static async Task<string> ReadProblemAsync(HttpResponseMessage response, string fallback)
    {
        try
        {
            var problem = await response.Content.ReadFromJsonAsync<ProblemModel>();
            return problem?.Detail ?? problem?.Title ?? fallback;
        }
        catch
        {
            return fallback;
        }
    }

    // Client-side shapes only — PingDto lives in the Api slice, which the client must not reference.
    private sealed record PingModel(Guid Id, string Message, DateTimeOffset CreatedAtUtc);

    private sealed record ProblemModel(string? Title, string? Detail, Dictionary<string, string[]>? Errors);
}
