<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <PageTitle>Not authorized</PageTitle>
                    <div class="rr-empty rr-router-state" role="alert">
                        <AppIcon Name="shield" Size="28" />
                        <strong>You don't have access to this page</strong>
                        <p>You're signed in, but this area needs a different role. An administrator can grant it.</p>
                        <a class="btn btn-primary btn-sm" href="">Go to Home</a>
                    </div>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="rr-empty rr-router-state" role="alert">
                <AppIcon Name="map" Size="28" />
                <strong>Nothing at this address</strong>
                <p>The page may have moved, or the link is wrong. Head back home to find your way.</p>
                <a class="btn btn-primary btn-sm" href="">Go to Home</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
