@namespace RapidRelief.Client.Common.Auth
@implements IDisposable
@inject DevRoleState RoleState

<div class="dev-role-picker"
     title="Dev role sent as X-Dev-Role on API calls (ignored by the server outside Development)">
    <label for="dev-role-select" class="me-1">Role:</label>
    <select id="dev-role-select" value="@RoleState.CurrentRole" @onchange="OnRoleChanged">
        <option value="@DevRoleState.None">None</option>
        <option value="Citizen">Citizen</option>
        <option value="Rescue">Rescue</option>
        <option value="Admin">Admin</option>
        <option value="NGO">NGO</option>
    </select>
</div>

@code {
    protected override void OnInitialized() => RoleState.Changed += StateHasChanged;

    private void OnRoleChanged(ChangeEventArgs e) => RoleState.SetRole(e.Value?.ToString() ?? DevRoleState.None);

    public void Dispose() => RoleState.Changed -= StateHasChanged;
}
