@namespace RapidRelief.Client.Common.Auth
@using System.Security.Claims
@using Microsoft.Extensions.Logging
@using RapidRelief.Client.Features.Auth
@inject AuthApi Auth
@inject NavigationManager Navigation
@inject HttpClient Http
@inject ILogger<LoginDisplay> Logger

<AuthorizeView>
    <Authorized>
        @{
            var displayName = ResolveDisplayName(context.User);
        }
        <span class="rr-user-chip" title="@displayName">
            <span class="rr-user-avatar" aria-hidden="true">
                <AppIcon Name="user" Size="14" />
            </span>
            <span class="rr-user-name">@displayName</span>
        </span>
        <button class="rr-icon-btn" type="button" @onclick="SignOutAsync" disabled="@_signingOut"
                title="Sign out" aria-label="Sign out">
            <AppIcon Name="logout" Size="18" />
        </button>
    </Authorized>
    <NotAuthorized>
        <a class="btn btn-primary btn-sm" href="auth/signin">Sign in</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _signingOut;
    private static string? _cachedProfileName;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(_cachedProfileName))
        {
            try
            {
                var resp = await Http.GetFromJsonAsync<RapidRelief.Shared.Contracts.Common.ApiEnvelope<UserProfileDto>>("api/auth/profile");
                if (!string.IsNullOrWhiteSpace(resp?.Data?.DisplayName) &&
                    !resp.Data.DisplayName.Equals("Google User", StringComparison.OrdinalIgnoreCase) &&
                    !resp.Data.DisplayName.Equals("Google-user", StringComparison.OrdinalIgnoreCase))
                {
                    _cachedProfileName = resp.Data.DisplayName;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                // D-117: falls back to the claims-based display name (ResolveDisplayName) — this
                // is only an enrichment fetch, but it used to fail silently with no trace.
                Logger.LogWarning(ex, "Profile display-name enrichment failed — using claims-based name");
            }
        }
    }

    private static string ResolveDisplayName(ClaimsPrincipal user)
    {
        if (!string.IsNullOrWhiteSpace(_cachedProfileName))
        {
            return _cachedProfileName;
        }

        var dn = user.FindFirst("display_name")?.Value;
        if (!string.IsNullOrWhiteSpace(dn) &&
            !dn.Equals("Google User", StringComparison.OrdinalIgnoreCase) &&
            !dn.Equals("Google-user", StringComparison.OrdinalIgnoreCase))
        {
            return dn;
        }

        var identityName = user.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(identityName))
        {
            if (identityName.Equals("Google User", StringComparison.OrdinalIgnoreCase) ||
                identityName.Equals("Google-user", StringComparison.OrdinalIgnoreCase) ||
                identityName.Equals("google-user@rr.dev", StringComparison.OrdinalIgnoreCase))
            {
                return "Citizen";
            }
            return identityName;
        }

        return "Citizen";
    }

    private async Task SignOutAsync()
    {
        if (_signingOut)
        {
            return;
        }

        _signingOut = true;
        try
        {
            _cachedProfileName = null;
            await Auth.LogoutAsync();
            Navigation.NavigateTo("/");
        }
        finally
        {
            _signingOut = false;
        }
    }
}
