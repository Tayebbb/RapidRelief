@namespace RapidRelief.Client.Common.Auth
@using RapidRelief.Client.Features.Auth
@inject AuthApi Auth
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <span class="rr-user-chip" title="@context.User.Identity?.Name">
            <span class="rr-user-avatar" aria-hidden="true">
                <AppIcon Name="user" Size="14" />
            </span>
            <span class="rr-user-name">@context.User.Identity?.Name</span>
        </span>
        <button class="rr-icon-btn" type="button" @onclick="SignOutAsync" disabled="@_signingOut"
                title="Sign out" aria-label="Sign out">
            <AppIcon Name="logout" Size="18" />
        </button>
    </Authorized>
    <NotAuthorized>
        <a class="btn btn-primary btn-sm" href="login">Sign in</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _signingOut;

    private async Task SignOutAsync()
    {
        if (_signingOut)
        {
            return;
        }

        _signingOut = true;
        try
        {
            await Auth.LogoutAsync();
            Navigation.NavigateTo("/");
        }
        finally
        {
            _signingOut = false;
        }
    }
}
