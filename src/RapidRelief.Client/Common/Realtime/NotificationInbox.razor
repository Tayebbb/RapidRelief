@page "/notifications"
@namespace RapidRelief.Client.Common.Realtime
@attribute [Authorize]
@implements IDisposable
@inject NotificationState State

<PageTitle>Notifications — RapidRelief</PageTitle>

<div class="rr-page-narrow">
    <header class="rr-page-head rr-reveal">
        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
            <h1 class="mb-0">Notifications</h1>
            <span class="rr-chip @(State.HubConnected ? "rr-chip-success" : "")"
                  title="@(State.HubConnected ? "Connected to the live hub" : "Checking for new notifications on a timer")">
                <span class="rr-dot @(State.HubConnected ? "rr-dot-success" : "")" aria-hidden="true"></span>
                @(State.HubConnected ? "Live" : "Polling")
            </span>
        </div>
        <p class="rr-page-lede">
            Alerts and AI assessments for your role.
            @if (State.UnreadCount > 0)
            {
                <span>@State.UnreadCount unread.</span>
            }
        </p>
    </header>

    <div class="inbox-toolbar rr-reveal rr-reveal-1">
        <button class="btn btn-outline-secondary btn-sm" type="button" disabled="@_busy" @onclick="RefreshAsync">
            <AppIcon Name="refresh" Size="15" />
            Refresh
        </button>
        <button class="btn btn-outline-secondary btn-sm" type="button" disabled="@(_busy || State.UnreadCount == 0)"
                @onclick="MarkAllAsync">
            <AppIcon Name="check" Size="15" />
            Mark all read
        </button>
    </div>

    @* Plain @-interpolation only — notification text can come from AI output or user content. *@
    @if (State.Items.Count == 0)
    {
        <div class="rr-empty rr-reveal rr-reveal-2">
            <AppIcon Name="inbox" Size="28" />
            <strong>No notifications yet</strong>
            <p>New alerts and AI assessments will appear here — live when connected, on a timer otherwise.</p>
        </div>
    }
    else
    {
        <ul class="inbox-list rr-reveal rr-reveal-2">
            @foreach (var item in State.Items)
            {
                <li class="inbox-item @(item.IsRead ? "read" : "unread")">
                    <div class="inbox-item-body">
                        <div class="inbox-summary">@item.Summary</div>
                        <div class="inbox-meta">@item.Topic · @item.CreatedAtUtc.ToLocalTime().ToString("g")</div>
                    </div>
                    @if (!item.IsRead)
                    {
                        <button class="btn btn-link btn-sm inbox-mark" type="button" disabled="@_busy"
                                @onclick="() => MarkReadAsync(item.Id)">
                            Mark read
                        </button>
                    }
                </li>
            }
        </ul>
    }
</div>

@code {
    private bool _busy;

    protected override void OnInitialized() => State.Changed += OnStateChanged;

    protected override Task OnInitializedAsync() => State.LoadAsync();

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private Task RefreshAsync() => RunAsync(() => State.LoadAsync());

    private Task MarkAllAsync() => RunAsync(async () => await State.MarkAllReadAsync());

    private Task MarkReadAsync(Guid id) => RunAsync(async () => await State.MarkReadAsync(id));

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose() => State.Changed -= OnStateChanged;
}
