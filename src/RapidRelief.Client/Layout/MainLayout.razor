@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @* Visible in every environment for now — harmless in prod because the server only
               honors X-Dev-Role where FakeAuth is registered (Development/Testing). *@
            <DevRolePicker />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
