@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @* Visible in every environment for now — harmless in prod because the server only
               honors X-Dev-Role where FakeAuth is registered (Development/Testing). The picker
               disables itself while a real session is active. *@
            <DevRolePicker />
            <AuthorizeView>
                <Authorized>
                    <NotificationBell />
                </Authorized>
            </AuthorizeView>
            <LoginDisplay />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@* Live push toasts. Rendered outside AuthorizeView so a dev-role session (D-035) sees them too;
   nothing is drawn until a notification actually arrives. *@
<ToastHost />
