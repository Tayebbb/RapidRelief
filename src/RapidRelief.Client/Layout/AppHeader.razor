@namespace RapidRelief.Client.Layout

<header class="app-header @(SidebarCollapsed ? "sidebar-collapsed" : null)">
    @if (ShowMenuButton)
    {
        <button class="rr-icon-btn menu-btn @(SidebarCollapsed ? "show-desktop" : null)" type="button" @onclick="OnMenuToggle"
                aria-label="@(MenuOpen ? "Close navigation" : (SidebarCollapsed ? "Expand sidebar" : "Open navigation"))" aria-expanded="@(MenuOpen || !SidebarCollapsed)"
                title="@(MenuOpen ? "Close navigation" : (SidebarCollapsed ? "Expand sidebar" : "Open navigation"))">
            <AppIcon Name="@(MenuOpen ? "close" : "menu")" Size="21" />
        </button>
    }

    <a class="mobile-brand @(AlwaysShowBrand || SidebarCollapsed ? "always-show" : null)" href="">
        <AppLogo Size="26" CssClass="brand-logo-img" />
        <span class="mobile-brand-text">RapidRelief</span>
    </a>

    <div class="header-tools">
        <ThemeToggle />
        <AuthorizeView>
            <Authorized>
                <NotificationBell />
            </Authorized>
        </AuthorizeView>
        <LoginDisplay />
    </div>
</header>

@code {
    [Parameter] public bool MenuOpen { get; set; }
    [Parameter] public EventCallback OnMenuToggle { get; set; }
    [Parameter] public bool ShowMenuButton { get; set; } = true;
    [Parameter] public bool AlwaysShowBrand { get; set; } = false;
    [Parameter] public bool SidebarCollapsed { get; set; } = false;
}
