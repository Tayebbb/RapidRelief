@page "/ui-showcase"
@namespace RapidRelief.Client.Pages

<PageTitle>UI Component System — RapidRelief</PageTitle>

<div class="rr-page">
    <header class="rr-page-head rr-reveal">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1>UI & Design System Showcase</h1>
                <p class="rr-page-lede">
                    Production-grade, accessible, token-driven Blazor WASM component library.
                </p>
            </div>
            <RrStatusIndicator Status="SystemStatus.Online" Text="Grid Connected" Pulsing="true" />
        </div>
    </header>

    <RrTabs ActiveKey="@_activeTab" ActiveKeyChanged="key => _activeTab = key">
        <RrTabItem Key="buttons" Label="Buttons & Actions" Icon="sparkles">
            <RrCard Class="mb-4">
                <Header>
                    <h3>Button Variants</h3>
                </Header>
                <ChildContent>
                    <p class="text-secondary small">Standard action buttons following RapidRelief color semantics.</p>
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                        <RrButton Variant="ButtonVariant.Primary" IconStart="send" OnClick="SimulateAction">Primary Action</RrButton>
                        <RrButton Variant="ButtonVariant.Secondary" IconStart="refresh" OnClick="SimulateAction">Secondary</RrButton>
                        <RrButton Variant="ButtonVariant.Outline" IconStart="filter" OnClick="SimulateAction">Outline</RrButton>
                        <RrButton Variant="ButtonVariant.Ghost" IconStart="inbox" OnClick="SimulateAction">Ghost</RrButton>
                        <RrButton Variant="ButtonVariant.Danger" IconStart="phone" OnClick="SimulateAction">Emergency SOS</RrButton>
                        <RrButton Variant="ButtonVariant.Link" OnClick="SimulateAction">Link Style</RrButton>
                    </div>

                    <h4 class="h6 text-secondary mt-4 mb-2">Sizes & Loading State</h4>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <RrButton Variant="ButtonVariant.Primary" Size="ButtonSize.Sm">Small</RrButton>
                        <RrButton Variant="ButtonVariant.Primary" Size="ButtonSize.Md">Medium (Default)</RrButton>
                        <RrButton Variant="ButtonVariant.Primary" Size="ButtonSize.Lg">Large</RrButton>
                        <RrButton Variant="ButtonVariant.Primary" IsLoading="true">Processing...</RrButton>
                        <RrButton Variant="ButtonVariant.Secondary" IsDisabled="true">Disabled</RrButton>
                    </div>
                </ChildContent>
            </RrCard>
        </RrTabItem>

        <RrTabItem Key="cards" Label="Cards & Feedback" Icon="activity">
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <RrCard Variant="CardVariant.Default">
                        <Header>
                            <div class="d-flex justify-content-between align-items-center">
                                <h3>Standard Card</h3>
                                <RrBadge Variant="BadgeVariant.Info">Info</RrBadge>
                            </div>
                        </Header>
                        <ChildContent>
                            <p class="text-secondary small">Standard elevation card for grouping operational information.</p>
                            <RrStatusIndicator Status="SystemStatus.Active" Text="Rescue Team En Route" />
                        </ChildContent>
                        <Footer>
                            <RrButton Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">View Details</RrButton>
                        </Footer>
                    </RrCard>
                </div>

                <div class="col-md-6">
                    <RrCard Variant="CardVariant.Interactive" OnClick="() => _showModal = true">
                        <Header>
                            <div class="d-flex justify-content-between align-items-center">
                                <h3>Interactive Card</h3>
                                <RrBadge Variant="BadgeVariant.Success" HasDot="true">Live</RrBadge>
                            </div>
                        </Header>
                        <ChildContent>
                            <p class="text-secondary small">Hoverable card that triggers a modal on click.</p>
                            <span class="text-primary small fw-bold">Click to test RrModal →</span>
                        </ChildContent>
                    </RrCard>
                </div>
            </div>

            <RrCard Class="mb-4">
                <Header>
                    <h3>Alert Banners</h3>
                </Header>
                <ChildContent>
                    <RrAlert Variant="AlertVariant.Danger" Title="Critical Disaster Alert" Dismissible="true">
                        High-level flood warning for Sector 3. Emergency teams dispatched.
                    </RrAlert>
                    <RrAlert Variant="AlertVariant.Warning" Title="Resource Limitation">
                        Medical supplies running low at Gulshan Emergency Hub.
                    </RrAlert>
                    <RrAlert Variant="AlertVariant.Success" Title="Mission Completed">
                        All 18 residents evacuated safely from Shelter 2.
                    </RrAlert>
                    <RrAlert Variant="AlertVariant.Info" Title="System Operational">
                        Real-time telemetry and OpenRouter AI pipeline active.
                    </RrAlert>
                </ChildContent>
            </RrCard>
        </RrTabItem>

        <RrTabItem Key="forms" Label="Inputs & Forms" Icon="layers">
            <RrCard Class="mb-4">
                <Header>
                    <h3>Form Controls</h3>
                </Header>
                <ChildContent>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <RrInput Label="Full Name" 
                                     Placeholder="Enter citizen or responder name" 
                                     @bind-Value="_sampleName" 
                                     IconStart="user" 
                                     IsRequired="true" />
                        </div>
                        <div class="col-md-6">
                            <RrInput Label="Emergency Phone Number" 
                                     Type="tel" 
                                     Placeholder="+880 17..." 
                                     @bind-Value="_samplePhone" 
                                     IconStart="phone" 
                                     HelperText="Used for automated dispatch SMS notifications." />
                        </div>
                        <div class="col-md-12">
                            <RrInput Label="Incident Location Search" 
                                     Placeholder="Search Dhaka sectors, coordinates, landmarks..." 
                                     @bind-Value="_sampleSearch" 
                                     IconStart="search" 
                                     IconEnd="map-pin" />
                        </div>
                    </div>
                </ChildContent>
            </RrCard>
        </RrTabItem>

        <RrTabItem Key="states" Label="UX States & Skeletons" Icon="clock">
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <RrCard>
                        <Header>
                            <h3>Empty State Pattern</h3>
                        </Header>
                        <ChildContent>
                            <RrEmptyState Icon="inbox" 
                                          Title="No Active SOS Dispatches" 
                                          Description="All reported emergencies in this quadrant have been assigned.">
                                <ActionContent>
                                    <RrButton Variant="ButtonVariant.Primary" Size="ButtonSize.Sm" IconStart="refresh">Refresh Feed</RrButton>
                                </ActionContent>
                            </RrEmptyState>
                        </ChildContent>
                    </RrCard>
                </div>

                <div class="col-md-6">
                    <RrCard>
                        <Header>
                            <h3>Error & Degraded State</h3>
                        </Header>
                        <ChildContent>
                            <RrErrorState IsDegradedMode="true" 
                                          Title="Demo Mode — Live Data Limited" 
                                          Message="Operating on local cache. Full AI classification remains available." 
                                          OnRetry="SimulateAction" />
                        </ChildContent>
                    </RrCard>
                </div>

                <div class="col-12">
                    <RrCard>
                        <Header>
                            <h3>Skeleton Shimmer Loaders</h3>
                        </Header>
                        <ChildContent>
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <RrSkeleton Shape="SkeletonShape.Circle" />
                                <div class="flex-grow-1">
                                    <RrSkeleton Shape="SkeletonShape.Text" Width="60%" />
                                    <RrSkeleton Shape="SkeletonShape.Text" Width="40%" />
                                </div>
                            </div>
                            <RrSkeleton Shape="SkeletonShape.Rectangle" Height="120px" />
                        </ChildContent>
                    </RrCard>
                </div>
            </div>
        </RrTabItem>
    </RrTabs>
</div>

<RrModal IsOpen="_showModal" Title="Operational Modal Test" OnClose="() => _showModal = false">
    <ChildContent>
        <p>This modal dialog is fully accessible with focus trap, backdrop dismissal, and Escape key listener.</p>
        <RrAlert Variant="AlertVariant.Info">
            All styles are strictly driven by <code>--rr-*</code> design tokens in both Light and Dark themes.
        </RrAlert>
    </ChildContent>
    <Footer>
        <RrButton Variant="ButtonVariant.Outline" OnClick="() => _showModal = false">Close</RrButton>
        <RrButton Variant="ButtonVariant.Primary" OnClick="() => _showModal = false">Acknowledge</RrButton>
    </Footer>
</RrModal>

@code {
    private string _activeTab = "buttons";
    private bool _showModal;
    private string _sampleName = "";
    private string _samplePhone = "";
    private string _sampleSearch = "";

    private void SimulateAction()
    {
        // No-op for showcase demonstration
    }
}
