# ConnectionStrings__Postgres=Host=<host>;Port=5432;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
# POSTGRES_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
